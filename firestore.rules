rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.xp is number &&
             data.xp >= 0 && data.xp <= 1000000 &&
             data.streak is number &&
             data.streak >= 0 && data.streak <= 10000 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('completedSentences' in data) || (data.completedSentences is list && data.completedSentences.size() <= 1000)) &&
             (!('masteredWords' in data) || (data.masteredWords is list && data.masteredWords.size() <= 1000)) &&
             (!('currentSentenceIndex' in data) || (data.currentSentenceIndex is number && data.currentSentenceIndex >= 0 && data.currentSentenceIndex <= 1000)) &&
             (!('sentencesDoneToday' in data) || (data.sentencesDoneToday is number && data.sentencesDoneToday >= 0 && data.sentencesDoneToday <= 100000)) &&
             (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('flapLevels' in data) || (data.flapLevels is map)) &&
             (!('flapHighScores' in data) || (data.flapHighScores is map));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAccessHash(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function isValidStudentAccess(data, accessId) {
      return data.accessHash is string &&
             data.accessHash == accessId &&
             isValidAccessHash(data.accessHash) &&
             data.teacherUid is string &&
             data.teacherUid == request.auth.uid &&
             isValidId(data.teacherUid) &&
             data.username is string &&
             data.username.size() >= 2 &&
             data.username.size() <= 40 &&
             !data.username.matches('.*[\\r\\n].*') &&
             (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 100)) &&
             data.createdAt is string &&
             data.createdAt.size() > 0 &&
             data.createdAt.size() <= 64;
    }

    function isValidTeacherStudentCredential(data, credId, userId) {
      return data.credId is string &&
             data.credId == credId &&
             isValidAccessHash(data.credId) &&
             data.teacherUid is string &&
             data.teacherUid == request.auth.uid &&
             data.teacherUid == userId &&
             isValidId(data.teacherUid) &&
             data.username is string &&
             data.username.size() >= 2 &&
             data.username.size() <= 40 &&
             !data.username.matches('.*[\\r\\n].*') &&
             data.password is string &&
             data.password.size() >= 4 &&
             data.password.size() <= 64 &&
             (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 100)) &&
             data.createdAt is string &&
             data.createdAt.size() > 0 &&
             data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       incoming().keys().hasAll(['userId', 'xp', 'streak']) &&
                       incoming().keys().hasOnly(['userId', 'xp', 'streak', 'email', 'displayName', 'photoURL', 'completedSentences', 'masteredWords', 'currentSentenceIndex', 'sentencesDoneToday', 'lastActiveDate', 'updatedAt', 'flapLevels', 'flapHighScores']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       incoming().userId == userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'streak', 'email', 'displayName', 'photoURL', 'completedSentences', 'masteredWords', 'currentSentenceIndex', 'sentencesDoneToday', 'lastActiveDate', 'updatedAt', 'flapLevels', 'flapHighScores']) &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId);

      // Private teacher-only student credential vault (strictly owner-only)
      match /student_credentials/{credId} {
        allow get: if isOwner(userId) && isValidAccessHash(credId);
        allow list: if isOwner(userId) && resource.data.teacherUid == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidAccessHash(credId) &&
                         incoming().keys().hasAll(['credId', 'teacherUid', 'username', 'password', 'createdAt']) &&
                         incoming().keys().hasOnly(['credId', 'teacherUid', 'username', 'password', 'schoolName', 'createdAt']) &&
                         isValidTeacherStudentCredential(incoming(), credId, userId);

        allow update: if false;

        allow delete: if isOwner(userId) && isValidAccessHash(credId);
      }
    }

    match /student_access/{accessId} {
      // Unauthenticated students can verify exact SHA-256(username:password) doc only; zero pupil PII is stored
      allow get: if isValidAccessHash(accessId);
      // Only the owning teacher can list student usernames they created
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidAccessHash(accessId) &&
                       incoming().keys().hasAll(['accessHash', 'teacherUid', 'username', 'createdAt']) &&
                       incoming().keys().hasOnly(['accessHash', 'teacherUid', 'username', 'schoolName', 'createdAt']) &&
                       isValidStudentAccess(incoming(), accessId);

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidAccessHash(accessId) &&
                       existing().teacherUid == request.auth.uid;
    }
  }
}
